# Vorlage — echte Werte gehören in .env.local (wird nicht eingecheckt).
# Zu finden im Supabase-Dashboard unter Project Settings → API.

NEXT_PUBLIC_SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Vollzugriff auf die Datenbank — niemals in den Browser-Code oder ins Repository.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Nur für das einmalige Anlegen des Administrators (npm run seed-admin).
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Vorname Nachname
ADMIN_PASSWORD=mindestens-8-zeichen
